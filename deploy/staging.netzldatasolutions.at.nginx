limit_req_zone $binary_remote_addr zone=netzldatasolutions_contact:10m rate=2r/m;
limit_req_zone $binary_remote_addr zone=netzldatasolutions_analytics:10m rate=20r/s;

server {
    server_name staging.netzldatasolutions.at;

    root /home/deploy/apps/netzldatasolutions.at;
    index index.html;

    access_log /var/log/nginx/staging.netzldatasolutions.at.access.log;
    error_log  /var/log/nginx/staging.netzldatasolutions.at.error.log;

    location ^~ /.well-known/acme-challenge/ {
        default_type text/plain;
        try_files $uri =404;
    }

    # Forward only the contact endpoint to the local Node service.
    location = /api/contact {
        limit_req zone=netzldatasolutions_contact burst=3 nodelay;
        limit_req_status 429;
        client_max_body_size 20k;

        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
    }

    # Accept only the minimized first-party analytics event endpoint.
    location = /api/analytics/events {
        limit_req zone=netzldatasolutions_analytics burst=40 nodelay;
        limit_req_status 429;
        client_max_body_size 8k;

        proxy_pass http://127.0.0.1:8060;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
        proxy_send_timeout 10s;
    }

    # Never expose Git metadata, dotfiles, or PHP source code.
    location ~ /\. {
        deny all;
    }

    location ~* \.(php|phtml|phar)$ {
        return 404;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/staging.netzldatasolutions.at/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/staging.netzldatasolutions.at/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = staging.netzldatasolutions.at) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name staging.netzldatasolutions.at;
    return 404; # managed by Certbot
}
