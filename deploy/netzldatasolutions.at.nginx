# Production configuration for netzldatasolutions.at and www.netzldatasolutions.at.
limit_req_zone $binary_remote_addr zone=netzldatasolutions_live_contact:10m rate=2r/m;
limit_req_zone $binary_remote_addr zone=netzldatasolutions_live_analytics:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=netzldatasolutions_live_funding_chat:10m rate=6r/m;

server {
    listen 80;
    listen [::]:80;
    server_name netzldatasolutions.at www.netzldatasolutions.at;

    root /home/deploy/apps/netzldatasolutions.at;

    location ^~ /.well-known/acme-challenge/ {
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://www.netzldatasolutions.at$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name netzldatasolutions.at;

    ssl_certificate /etc/letsencrypt/live/netzldatasolutions.at/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/netzldatasolutions.at/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://www.netzldatasolutions.at$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name www.netzldatasolutions.at;

    root /home/deploy/apps/netzldatasolutions.at;
    index index.html;

    access_log /var/log/nginx/netzldatasolutions.at.access.log;
    error_log  /var/log/nginx/netzldatasolutions.at.error.log;

    ssl_certificate /etc/letsencrypt/live/netzldatasolutions.at/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/netzldatasolutions.at/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location ^~ /.well-known/acme-challenge/ {
        default_type text/plain;
        try_files $uri =404;
    }

    location = /api/contact {
        limit_req zone=netzldatasolutions_live_contact burst=3 nodelay;
        limit_req_status 429;
        client_max_body_size 20k;

        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
    }


    location = /api/funding-chat/message {
        limit_req zone=netzldatasolutions_live_funding_chat burst=6 nodelay;
        limit_req_status 429;
        client_max_body_size 28k;

        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 105s;
        proxy_send_timeout 105s;
    }

    location = /api/analytics/events {
        limit_req zone=netzldatasolutions_live_analytics burst=40 nodelay;
        limit_req_status 429;
        client_max_body_size 8k;

        proxy_pass http://127.0.0.1:8060;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
        proxy_send_timeout 10s;
    }

    location ~ /\. {
        deny all;
    }

    location ~* \.(php|phtml|phar)$ {
        return 404;
    }

    location = / {
        try_files /index.html =404;
    }

    location = /index.html {
        return 301 /;
    }

    location = /index {
        return 301 /;
    }

    location = /tickets/index.html {
        return 301 /tickets/;
    }

    location = /tickets/index {
        return 301 /tickets/;
    }

    location ~ ^/(.+)\.html$ {
        return 301 /$1$is_args$args;
    }

    location / {
        try_files $uri $uri/ $uri.html =404;
    }
}
