{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daniel-os.local/schemas/project-integration-v1.json",
  "title": "Daniel OS project integration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "notes", "workflow", "data_policy"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "owner", "repository"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "customer": { "type": "string" },
        "repository": { "type": "string", "minLength": 1 }
      }
    },
    "notes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "project_overview", "project_history", "competence_profile", "additional"],
      "properties": {
        "primary": { "type": "string", "minLength": 1 },
        "project_overview": { "type": "string", "minLength": 1 },
        "project_history": { "type": "string", "minLength": 1 },
        "competence_profile": { "type": "string", "minLength": 1 },
        "additional": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "require_preview", "require_write_approval", "require_version_check", "archive_primary_on_close"],
      "properties": {
        "language": { "const": "de" },
        "require_preview": { "const": true },
        "require_write_approval": { "const": true },
        "require_version_check": { "const": true },
        "archive_primary_on_close": { "type": "boolean" }
      }
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forbid_secrets", "forbid_personal_raw_data", "allowed_note_paths"],
      "properties": {
        "forbid_secrets": { "const": true },
        "forbid_personal_raw_data": { "const": true },
        "allowed_note_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    }
  }
}
